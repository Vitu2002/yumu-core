{
    "name": "yumu-core",
    "version": "1.2.0",
    "description": "Just another discord bot boilerplate.",
    "main": "dist/index.js",
    "author": "Vitu2002 <contact@vitu2002.dev>",
    "license": "MIT",
    "private": false,
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "build": "bun build src/index.ts --outdir=dist --target=node",
        "start": "bun run dist/index.js",
        "dev:node": "ts-node-dev --respawn src/index.ts",
        "build:node": "tsc",
        "start:node": "node dist/index.js"
    },
    "devDependencies": {
        "bun-types": "^1.3.5",
        "typescript": "^5.2.2",
        "ts-node-dev": "^2.0.0"
    },
    "dependencies": {
        "discord.js": "^14.13.0",
        "dotenv": "^16.3.1",
        "dayjs": "^1.11.9",
        "picocolors": "^1.1.1"
    }
}
